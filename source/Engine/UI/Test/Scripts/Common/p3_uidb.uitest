# The UI database lists the phase 3 properties, effects, animations and the layer-less capability.
wait 8
console ui_load GameData/ui/kit/tests/p3_motion.xml
wait_frames 10
expect_uidb cap:painting cap:motion nocap:layers
expect_uidb cssProperties:background-image cssProperties:box-shadow cssProperties:transform cssProperties:transition cssProperties:animation cssProperties:mask-image
expect_uidb paintEffects:Arc paintEffects:linear-gradient() paintEffects:conic-gradient() paintEffects:grayscale() paintEffects:clip-path
expect_uidb unavailable:blur() unavailable:drop-shadow() unavailable:backdrop-filter
expect_uidb tags:Arc easings:cubic-bezier() easings:steps() animations:pulse
expect_uidb preview:engine.effects.element preview:engine.animation.timeline
expect_ui_errors 0
quit
