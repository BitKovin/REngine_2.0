<root>
  <styles>
    <include src="GameData/ui/theme.css"/>
  </styles>
  <snippets>
    <snippet name="CategoryHeader" params="label=''">
      <Panel class="bind-category"><Panel class="bind-accent"/><Label class="bind-category-text" text="{label}"/></Panel>
    </snippet>
    <snippet name="ActionRow" params="label=''">
      <Panel class="bind-row">
        <Label class="bind-label" text="{label}"/>
        <Panel class="slot-group"><KeyBindSlot id="kb0"/><KeyBindSlot id="kb1"/></Panel>
        <Panel class="slot-group"><KeyBindSlot id="gp0"/><KeyBindSlot id="gp1"/></Panel>
        <TextButton id="reset" class="kit-small-button" text="${SETTINGS_INPUT_ROW_RESET}"/>
      </Panel>
    </snippet>
  </snippets>
  <Panel id="input" class="kit-page">
    <Card title="${SETTINGS_INPUT_SENSITIVITY_HEADER}">
      <SettingRow label="${SETTINGS_INPUT_MOUSE_SENSITIVITY}"><Slider id="mouse" min="0.01" max="2" step="0.01" bind="setting:input.mouse_sensitivity"/><Label class="setting-value" text="{value:%.2f}"/></SettingRow>
      <SettingRow label="${SETTINGS_INPUT_GAMEPAD_SENSITIVITY}"><Slider id="pad" min="0.1" max="3" step="0.05" bind="setting:input.gamepad_sensitivity"/><Label class="setting-value" text="{value:%.2f}"/></SettingRow>
      <SettingRow label="${SETTINGS_INPUT_INVERT_LOOK_Y}">
        <ToggleButton id="invert" class="kit-toggle setting-control" bind="setting:input.invert_y"><Label class="on" text="${SETTINGS_TOGGLE_ON}"/><Label class="off" text="${SETTINGS_TOGGLE_OFF}"/></ToggleButton>
      </SettingRow>
    </Card>
    <Card title="${SETTINGS_INPUT_KEY_BINDINGS_HEADER}">
      <Panel class="bind-caption-row">
        <Panel style="width: 316px; height: 1px"/>
        <Label class="bind-caption" text="${SETTINGS_INPUT_CAPTION_KEYBOARD_MOUSE}"/>
        <Label class="bind-caption" text="${SETTINGS_INPUT_CAPTION_GAMEPAD}"/>
      </Panel>
      <Panel id="binds" class="bind-list" scrollbar="true"/>
    </Card>
    <StyledButton id="resetall" text="${SETTINGS_INPUT_RESET_ALL}" onactivate="ResetAll()"/>
  </Panel>
</root>
