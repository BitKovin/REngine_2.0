<root>
  <styles>
    <include src="GameData/ui/styles/theme.css"/>
  </styles>
  <Panel id="pause" class="screen pause" pauses-game="true" hides-hud="true">
    <Panel class="menu-column">
      <Button id="presume" class="menu-item" default-focus="true" onactivate="Back()">
        <Label class="item-text" text="${PAUSE_MENU_RESUME}"/>
        <Panel class="item-line"/>
      </Button>
      <Button id="psave" class="menu-item" onactivate="OpenSave()">
        <Label class="item-text" text="${PAUSE_MENU_SAVE}"/>
        <Panel class="item-line"/>
      </Button>
      <Button id="pload" class="menu-item" onactivate="OpenLoad()">
        <Label class="item-text" text="${PAUSE_MENU_LOAD}"/>
        <Panel class="item-line"/>
      </Button>
      <Button id="psettings" class="menu-item" onactivate="OpenSettings()">
        <Label class="item-text" text="${PAUSE_MENU_SETTINGS}"/>
        <Panel class="item-line"/>
      </Button>
      <Button id="pquit" class="menu-item" onactivate="Push('ui/confirm_quit.xml')">
        <Label class="item-text" text="${PAUSE_MENU_QUIT}"/>
        <Panel class="item-line"/>
      </Button>
    </Panel>
    <ActionBar class="action-bar"/>
  </Panel>
</root>
