# StealthAction pilot: the markup pause menu on the main menu stack.
wait 8
ui_screenshot 01_hud
action pause
wait_frames 10
expect_stack depth == 1
expect_stack top contains pause.xml
expect_engine paused == 1
ui_screenshot 02_pause
expect presume focus == 1
action ui_down
wait_frames 3
expect psave focus == 1
action ui_up
wait_frames 3
expect presume focus == 1
# settings round trip: focus and navigation must work again afterwards
console ui_focus psettings
wait_frames 3
action ui_confirm
wait_frames 10
action ui_cancel
wait_frames 10
expect pause visible == 1
expect presume focus == 1
action ui_down
wait_frames 3
expect psave focus == 1
console ui_focus pquit
wait_frames 3
action ui_confirm
wait_frames 5
expect_stack depth == 2
expect_stack top contains confirm_quit.xml
expect pause visible == 1
ui_screenshot 03_confirm
action ui_cancel
wait_frames 5
expect_stack depth == 1
expect_stack top contains pause.xml
action ui_cancel
wait_frames 12
expect_stack depth == 0
expect_engine paused == 0
ui_screenshot 04_resumed
expect_ui_errors 0
quit
