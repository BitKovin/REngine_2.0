<root>
  <styles><style>
    #sv { width: 400px; height: 400px; x: 100px; y: 100px; }
  </style></styles>
  <SceneView id="sv" camera-position="0 0.2 1.3" camera-target="0 0 0" fov="40" background="#204060" orbit="true">
    <Model id="m" src="GameData/models/pickups/weapons/shotgun.glb" rotation="0 {spin} 0" two-sided="true"/>
    <Light type="directional" direction="-0.3 -1 -0.5" color="#ffffff" intensity="1.2"/>
    <Light type="point" position="0.5 0.4 0.9" color="#ff9050" intensity="2" range="4"/>
    <Light type="ambient" color="#909090"/>
  </SceneView>
</root>
