      #small { x: 300px; y: 100px; width: 16px; height: 16px; }
      #bg { x: 400px; y: 100px; width: 64px; height: 64px; background-image: url(GameData/ui/kit/tests/p7_icon.svg); background-size: 64px 64px; }
    </style>
  </styles>
  <Panel id="proot" class="b">
    <Image id="big" class="b" src="GameData/ui/kit/tests/p7_icon.svg"/>
    <Image id="small" class="b" src="GameData/ui/kit/tests/p7_icon.svg"/>
    <Panel id="bg" class="b"/>
  </Panel>
</root>
